# Vaakora AI Voice Calling Platform (Default active client workspace: Pontis LLP)
# Copy this file to `.env` and fill in your real API keys. NEVER commit `.env`.

# === REQUIRED VOICE ENGINE KEYS ===
# Smallest AI Lightning v3.1 (Primary TTS voice engine)
SMALLEST_API_KEY=

# Cartesia Sonic TTS (Secondary fallback voice engine — sign up at https://play.cartesia.ai)
# Note: Until filled in, the engine automatically uses Deepgram Aura-2 as fallback.
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6

# Deepgram Nova-3 Streaming STT & Aura-2 fallback TTS (Required — https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Fast LLM Brains (Groq primary, Gemini fallback)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=

# === DEPLOYMENT & DATABASE ===
# Shared SQLite path (overridden automatically to /app/data/telecalling.db inside Docker)
DB_PATH=
# Optional external WebSocket URL if hosting engine on a separate subdomain (e.g. wss://engine.yourdomain.com/ws/engine)
ENGINE_WS_URL=
CORS_ALLOW_ORIGINS=*
FORCE_IPV4=true

# === TELEPHONY TRUNKS (VOBIZ SIP / EXOTEL / TWILIO) ===
# Vobiz SIP / DID Indian Trunk
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CALLER_ID=

# Twilio (Optional backup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Workspace metadata
BUSINESS_NAME=Pontis LLP
